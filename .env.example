# SEIS Environment Template
# Copy to .env and set strong values for production:
#   cp .env.example .env

# --- Database ---
# Used by docker-compose and backend
DATABASE_URL=postgres://seis_user:seis_password@localhost:5432/seis_db?sslmode=disable
POSTGRES_DB=seis_db
POSTGRES_USER=seis_user
POSTGRES_PASSWORD=seis_password

# --- Backend ---
PORT=8080
# Comma-separated allowed frontend origins (include every host you open the site from,
# e.g. localhost, 127.0.0.1, or your LAN IP — otherwise the browser gets "Failed to fetch")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# IMPORTANT: override in production with a 32+ char random secret
# Generate: openssl rand -base64 32
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
# Gin mode: debug | release
GIN_MODE=release

# --- Frontend (build-time) ---
# URL the browser uses to reach the API. Leave empty for same-origin /api
# (proxied by nginx in docker, by vite in dev) — works from any host/IP.
# Only set an absolute URL when the API lives on a different domain.
VITE_API_URL=

# --- Optional: prod domain ---
# Set when deploying behind a reverse proxy
# DOMAIN=seis.example.com
